<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WHT · ORDERBOOK ODYSSEY</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}html,body{width:100%;height:100%;overflow:hidden;background:#000;color:#fff;font-family:"Courier New",Courier,monospace;user-select:none;display:flex;align-items:center;justify-content:center}#stage{position:relative;width:50vw;height:50vh;min-width:340px;min-height:240px;background:#000;border:1px solid rgba(255,255,255,.18);border-radius:10px;overflow:hidden}#stage canvas{position:absolute;inset:0;width:100%;height:100%;display:block}#telemetryHud{position:absolute;top:10px;right:12px;z-index:20;text-align:right;pointer-events:none;background:rgba(4,6,10,.68);border:1px solid rgba(255,255,255,.14);border-radius:8px;padding:6px 10px}.tele-price{font-size:.92rem;font-weight:900;letter-spacing:.06em;color:#19ff8c;font-variant-numeric:tabular-nums}.tele-sub{font-size:.62rem;font-weight:700;letter-spacing:.1em;color:rgba(255,255,255,.72);margin-top:2px;font-variant-numeric:tabular-nums}#infoModal{position:absolute;bottom:48px;right:10px;z-index:30;width:min(310px,calc(100% - 20px));background:rgba(5,7,12,.94);border:1px solid rgba(255,255,255,.24);border-radius:9px;padding:12px 14px;display:flex;flex-direction:column;gap:7px}#infoModal.hidden{display:none}.info-title{font-size:.76rem;font-weight:900;letter-spacing:.14em;color:#fff}.info-text{font-size:.66rem;line-height:1.45;color:rgba(255,255,255,.76)}.info-footer{font-size:.64rem;letter-spacing:.1em;color:rgba(255,255,255,.55);border-top:1px solid rgba(255,255,255,.12);padding-top:6px;margin-top:2px;text-transform:uppercase}.info-footer strong{color:#fff}#controlsHud{position:absolute;bottom:10px;right:10px;z-index:20;display:flex;align-items:center;gap:6px;background:rgba(5,6,10,.78);border:1px solid rgba(255,255,255,.15);border-radius:8px;padding:5px 8px;opacity:.35;transition:opacity .2s ease}#stage:hover #controlsHud{opacity:1}#rhythmName{font-size:.65rem;font-weight:900;color:rgba(255,255,255,.78);letter-spacing:.08em;padding:0 6px;white-space:nowrap}.btn{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.22);border-radius:6px;padding:5px 10px;font-size:.72rem;font-weight:700;cursor:pointer;font-family:inherit}.btn:hover{background:rgba(255,255,255,.2)}.btn.active{background:#fff;color:#000;border-color:#fff}.q-btn,.info-btn{width:26px;padding:5px 0;text-align:center}.info-btn{font-style:italic;font-family:Georgia,serif;font-weight:900}#startOverlay{position:absolute;inset:0;z-index:50;background:rgba(0,0,0,.9);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:18px;text-align:center;cursor:pointer;transition:opacity .3s ease}#startOverlay.hidden{opacity:0;pointer-events:none}.start-brand{font-size:.68rem;font-weight:900;letter-spacing:.32em;color:#19ff8c;border:1px solid rgba(25,255,140,.4);padding:2px 10px;border-radius:999px}.start-title{font-size:clamp(1.15rem,2.6vw,1.75rem);font-weight:900;letter-spacing:.18em;color:#fff}.start-sub{font-size:.68rem;color:rgba(255,255,255,.65);max-width:340px;line-height:1.45;margin-bottom:6px}.start-cta{padding:9px 22px;border-radius:999px;background:#fff;color:#000;font-weight:900;font-size:.76rem;letter-spacing:.12em;text-transform:uppercase}
  </style>
</head>
<body oncontextmenu="return false">
  <div id="stage">
    <canvas id="bgGlCanvas"></canvas>
    <canvas id="fg2dCanvas"></canvas>
    <div id="telemetryHud">
      <div class="tele-price" id="telePrice">BTC ---</div>
      <div class="tele-sub" id="teleSpeed">0 KM/S</div>
    </div>
    <div id="infoModal" class="hidden">
      <div class="info-title">WHT · ORDERBOOK ODYSSEY</div>
      <p class="info-text">A 100% procedural audiovisual journey sculpted in real time by the live <strong>Bitcoin (BTCUSDT) Order Book</strong> and trade flow.</p>
      <p class="info-text">Every canyon ridge, 360° tunnel, asteroid field, curve, and synth frequency is mathematically synthesized on the fly from live market depth, momentum, and volatility — zero pre-recorded audio or 3D assets.</p>
      <div class="info-footer">Created by <strong>WHT</strong></div>
    </div>
    <div id="controlsHud">
      <span id="rhythmName">SCHRANZ WAREHOUSE</span>
      <button id="remixBtn" class="btn" title="Next rhythm">⏭ Ritmo</button>
      <button id="playBtn" class="btn active" title="Play / Pause">⏸</button>
      <button id="lowGfxBtn" class="btn q-btn" title="Quality: High / Low Graphic">Q</button>
      <button id="infoBtn" class="btn info-btn" title="About this project">i</button>
    </div>
    <div id="startOverlay">
      <div class="start-brand">WHT</div>
      <div class="start-title">ORDERBOOK ODYSSEY</div>
      <div class="start-sub">Procedural 3D Bitcoin Order Book Journey &amp; Real-Time Techno Synthesis</div>
      <div class="start-cta">▶ Start Journey</div>
    </div>
  </div>
  <script src="odyssey.min.js"></script>
</body>
</html>
